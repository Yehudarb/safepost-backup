# Non-secret QA identity. Set these exact names in the separate hosting projects.
SAFEPOST_ENV=qa
SAFEPOST_EXPECTED_SUPABASE_REF=tesagheacuzkhecaihte
NODE_ENV=production
AUTH_ENFORCED=true
WORKER_AUTH_ENFORCED=true
ENGAGEMENT_ENABLED=true

# Resolve these after the two QA projects have reserved their final domains.
ALLOWED_DASHBOARD_ORIGINS=https://safepost-qa.vercel.app
QA_DASHBOARD_ORIGIN=https://safepost-qa.vercel.app
VITE_PUBLIC_APP_ORIGIN=https://safepost-qa.vercel.app
VITE_API_URL=https://REPLACE-WITH-QA-RENDER-HOST

# QA Supabase only.
SUPABASE_URL=https://tesagheacuzkhecaihte.supabase.co
VITE_SUPABASE_URL=https://tesagheacuzkhecaihte.supabase.co

# Obtain these separately from the QA Supabase project. Never copy their
# production counterparts and never commit actual values.
SUPABASE_SERVICE_KEY=REPLACE_IN_RENDER_DASHBOARD
SUPABASE_ANON_KEY=REPLACE_IN_RENDER_DASHBOARD
VITE_SUPABASE_ANON_KEY=REPLACE_IN_VERCEL_DASHBOARD
