# SafePost environment configuration example
# Copy this file to `.env` and replace placeholders with real values.
# Never commit real secrets.

# ---- Runtime ----
# Local development: development
# Beta / production: production
NODE_ENV=development
PORT=3001

# ---- Backend Supabase (required) ----
# Project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=https://your-project.supabase.co
# Service-role key for the backend only. Keep secret.
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
# Optional compatibility fallback only when service-role is unavailable.
# SUPABASE_KEY=your-supabase-anon-key

# ---- Security-critical auth flags ----
# Local development can leave these false while migrating.
# Beta / production should leave both UNSET or set them to true.
# In non-development runtimes, SafePost now fails to start if either is false.
AUTH_ENFORCED=false
WORKER_AUTH_ENFORCED=false

# ---- Extension authentication ----
# Recommended beta / production setup:
# 1. Prefer dashboard pairing for each browser worker.
# 2. Only use EXTENSION_API_KEY for a single trusted operator.
# 3. If EXTENSION_API_KEY is set, EXTENSION_KEY_WORKSPACE_ID must be set to the
#    exact workspace UUID it is allowed to access.
EXTENSION_API_KEY=
EXTENSION_KEY_WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# ---- Frontend auth (required for beta / production) ----
# Use the Supabase anon/public key here, never the service key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ---- Frontend API ----
# Local development: http://localhost:3001
# Beta / production: your deployed backend URL
VITE_API_URL=http://localhost:3001

# ---- Optional AI providers ----
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---- Optional upload limit override ----
UPLOAD_MAX_MB=50

# ---- Demo mode ----
# When set, the login screen shows a demo entry point.
DEMO_EMAIL=demo@safepost.local
DEMO_PASSWORD=change-me-demo-pass
VITE_DEMO_EMAIL=demo@safepost.local
VITE_DEMO_PASSWORD=change-me-demo-pass
