# SafePost environment configuration — EXAMPLE (placeholders only, no real secrets)
# Copy to `.env` and fill in real values. `.env` is git-ignored.

# ---- Supabase (required by the backend) ----
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=https://your-project.supabase.co
# Service-role key (server only — bypasses RLS). Keep secret.
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
# Optional: anon/public key fallback (only if not using the service key)
# SUPABASE_KEY=your-supabase-anon-key

# ---- Runtime ----
# development | production
NODE_ENV=development
# Backend HTTP port (defaults to 3001 if unset)
PORT=3001

# ---- Auth enforcement (Phase 3) ----
# When 'true', the backend REQUIRES a valid Supabase token on dashboard routes
# and scopes every query to the caller's workspace. When unset/false, the app
# behaves openly as before (safe default for production until cutover).
AUTH_ENFORCED=false

# ---- Optional AI providers (used by AI post-assistant features) ----
# Leave blank to disable the related features.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---- Frontend (Vite) ----
# Backend API base URL the dashboard talks to.
# Local dev: http://localhost:3001   Production: your deployed backend URL.
# If unset, the app falls back to the built-in production URL.
VITE_API_URL=http://localhost:3001

# ---- Frontend auth (Supabase) — Phase 3 ----
# Dev/staging Supabase project used for authentication. When BOTH are set the
# dashboard requires login; when unset, the app stays open (auth disabled).
# Use the anon/public key here (NOT the service key).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ---- Demo mode (Phase 4) ----
# Shared demo login. When BOTH are set, the login screen shows a "Try the demo"
# button. The demo account is a synthetic-data-only workspace (see
# scripts/setup-demo.cjs). This is NOT a real secret — it only unlocks demo data.
DEMO_EMAIL=demo@safepost.local
DEMO_PASSWORD=change-me-demo-pass
VITE_DEMO_EMAIL=demo@safepost.local
VITE_DEMO_PASSWORD=change-me-demo-pass
