{
  "name": "fb-auto-suite",
  "version": "2.1.1",
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production node server/index.cjs",
    "start-all": "concurrently \"cross-env NODE_ENV=development node server/index.cjs\" \"npm run dev\"",
    "dev": "cross-env NODE_ENV=development vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:validation && npm run test:sync && npm run test:performance",
    "test:phase3": "node -r ./server/tests/loadTestEnv.cjs tests/phase3-isolation.test.cjs",
    "test:phase4": "node -r ./server/tests/loadTestEnv.cjs tests/phase4-demo.test.cjs",
    "test:phase5": "node -r ./server/tests/loadTestEnv.cjs tests/phase5-pairing.test.cjs",
    "test:phase6": "node -r ./server/tests/loadTestEnv.cjs tests/phase6-queue.test.cjs",
    "test:phase7": "node -r ./server/tests/loadTestEnv.cjs tests/phase7-detection.test.cjs",
    "test:phase8": "node -r ./server/tests/loadTestEnv.cjs tests/phase8-scheduling-isolation.test.cjs",
    "test:phase9": "node -r ./server/tests/loadTestEnv.cjs tests/phase9-realtime-isolation.test.cjs",
    "test:security": "npm run test:phase3 && npm run test:phase5 && npm run test:phase8 && npm run test:phase9",
    "test:validation": "node -r ./server/tests/loadTestEnv.cjs server/tests/validation.test.cjs",
    "test:sync": "node -r ./server/tests/loadTestEnv.cjs server/tests/sync.test.cjs",
    "test:performance": "node -r ./server/tests/loadTestEnv.cjs server/tests/performance.test.cjs",
    "test:phase10": "node -r ./server/tests/loadTestEnv.cjs tests/phase10-extension-cors.test.cjs",
    "test:phase11": "node -r ./server/tests/loadTestEnv.cjs tests/phase11-worker-status-callback.test.cjs",
    "test:phase12": "node -r ./server/tests/loadTestEnv.cjs tests/phase12-moderation-resume-safety.test.cjs",
    "test:phase13": "node -r ./server/tests/loadTestEnv.cjs tests/phase13-manual-group-sync-path.test.cjs",
    "test:phase14": "node -r ./server/tests/loadTestEnv.cjs tests/phase14-preflight-moderation.test.cjs",
    "test:phase15": "node -r ./server/tests/loadTestEnv.cjs tests/phase15-dry-run-guard.test.cjs",
    "test:phase16": "node -r ./server/tests/loadTestEnv.cjs tests/phase16-worker-telemetry.test.cjs",
    "test:p1-security": "node -r ./server/tests/loadTestEnv.cjs tests/p1-beta-security-hardening.test.cjs",
    "test:observability": "node -r ./server/tests/loadTestEnv.cjs tests/phase17-observability.test.cjs",
    "test:id-validation": "node -r ./server/tests/loadTestEnv.cjs tests/phase18-id-validation.test.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@google/generative-ai": "^0.21.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.95.2",
    "body-parser": "^2.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "framer-motion": "^12.33.0",
    "helmet": "^8.0.0",
    "joi": "^18.1.2",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sqlite3": "^6.0.1",
    "tailwind-merge": "^1.14.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "vite": "^6.3.5"
  }
}
