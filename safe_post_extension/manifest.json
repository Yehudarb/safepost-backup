{
    "manifest_version": 3,
    "name": "SafePost Automation",
    "version": "9.0",
    "description": "Automated Facebook Group Posting (Supabase Storage Sync). Configurable API server via popup settings.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "alarms",
        "clipboardRead",
        "clipboardWrite"
    ],
    "host_permissions": [
        "https://www.facebook.com/*",
        "https://mbasic.facebook.com/*",
        "http://localhost:3001/*",
        "https://safepost-backup.onrender.com/*",
        "https://*.supabase.co/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.facebook.com/*"
            ],
            "js": [
                "fbUtils.js",
                "content.js"
            ]
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "128": "icons/icon128.png"
    }
}
