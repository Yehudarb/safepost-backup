{
    "manifest_version": 3,
    "name": "SafePost Automation",
    "version": "7.4",
    "description": "Automated Facebook Group Posting (Supabase Storage Sync). Configurable API server via popup settings.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "alarms",
        "clipboardRead",
        "clipboardWrite",
        "cookies"
    ],
    "host_permissions": [
        "https://www.facebook.com/*",
        "https://mbasic.facebook.com/*",
        "http://localhost:3001/*",
        "https://*.supabase.co/*"
    ],
    "externally_connectable": {
        "matches": [
            "http://localhost:5173/*",
            "http://127.0.0.1:5173/*",
            "http://localhost:3001/*",
            "http://127.0.0.1:3001/*"
        ]
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.facebook.com/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "128": "icons/icon128.png"
    }
}